<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <TargetFrameworks
      Condition="'$(NETCoreSdkVersion)' != '' and $([MSBuild]::VersionLessThan('$(NETCoreSdkVersion)', '10.0.100'))"
      >net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>0.1.0-preview.18</Version>
    <RepositoryUrl>https://github.com/kantagara/DotNative.Permissions</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <DotNativePluginEntry>PermissionsPlugin</DotNativePluginEntry>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DotNative.Plugins.Core" Version="0.1.0-preview.18" />
    <PackageReference Include="DotNative.Plugins.Build" Version="0.1.0-preview.18" PrivateAssets="none" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.16" />
    <None Remove="Platform/**/*;buildTransitive/**/*;Generated/**/*" />
    <None
      Include="Platform/**/*;buildTransitive/**/*;Generated/**/*"
      Pack="true"
      PackagePath="%(Identity)"
    />
    <None Remove="README.md;ORIGIN.md;LICENSE" />
    <None Include="README.md;ORIGIN.md;LICENSE" Pack="true" PackagePath="%(Identity)" />
  </ItemGroup>
  <Import Project="build/PluginAuthoring.props" />
  <Import Project="build/PluginAuthoring.targets" />
  <Import Project="buildTransitive/DotNative.Permissions.targets" Condition="'$(DotNativePluginExport)' == 'true'" />
</Project>
